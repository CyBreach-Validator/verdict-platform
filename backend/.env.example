# Environment for the CyBreach Validator backend (Pod Delta).
#
# Copy to `.env` and fill in real values. There are no defaults for any secret
# in this service: `app/security/security.py` and `app/api/auth.py` read these
# at import and refuse to sign a token or accept a login when they are missing,
# rather than falling back to a value that is in the source tree.

# --- Database --------------------------------------------------------------
# Required. Also used by Alembic; it is the single source of truth for the
# migration target. `alembic.ini` deliberately has no URL of its own.
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/verdict_db

# --- Authentication --------------------------------------------------------
# Required. HS256 signing key for access tokens. There is no default: a
# hardcoded fallback would let anyone who has read the repository forge a
# token. Generate one with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Required. The bootstrap analyst account that `/api/v2/auth/login` accepts.
# This service authenticates a single operator from the environment rather than
# from the users table, so set it before first login.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional. Access-token lifetime in minutes. Defaults to 30 when unset.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Message bus -----------------------------------------------------------
# Optional. Defaults to the local hybrid-run broker on 9092. Set this to the
# broker host when Delta runs outside the compose topology.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# NOTE: there is deliberately no KAFKA_CONSUMER_GROUP. Nothing in Delta
# consumes from the bus -- it only publishes verdicts -- and the evidence
# subscription belongs to the Validation Engine (Pod Beta). A group id here
# would have declared an intent no code backed, and implied ownership of a
# subscription Delta does not have.
