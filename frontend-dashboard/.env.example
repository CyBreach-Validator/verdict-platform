# Build-time configuration for the CyBreach dashboard (Pod Delta).
#
# Vite inlines `import.meta.env.VITE_*` at build time, so these are baked into
# the bundle: setting them requires a rebuild, not a restart. Only variables
# prefixed with `VITE_` are exposed to the client.

# Base URL of Delta's backend, including the version prefix. Every service in
# `src/services/` calls paths like `/verdicts` relative to this, so it must
# include `/api/v2` -- the backend mounts all eight routers under it.
# Defaults to http://127.0.0.1:8000/api/v2 when unset (local dev only).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v2

# Verdict feed WebSocket. Must include the access token at connect time --
# the server closes the socket with code 1008 without one, since the browser
# `WebSocket` constructor cannot send an `Authorization` header.
# Use `wss://` in production; the client will not derive the scheme for you
# when this is set explicitly.
VITE_WS_URL=ws://127.0.0.1:8000/ws/verdicts
